#!/usr/bin/env bash

set -euo pipefail

readonly BASE_VM_NAME="vm-vpn-base"
readonly BASE_IMAGE_VERSION="12"
readonly INSTANCE_PREFIX="vm-vpn-"
REPO_ROOT="${VM_VPN_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
readonly REPO_ROOT
readonly CONFIG_ROOT="${VM_VPN_CONFIG_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/vm-vpn}"
readonly BUILD_SCRIPT="${VM_VPN_BUILD_SCRIPT:-${REPO_ROOT}/macos/scripts/build-image}"
readonly BASE_MARKER="${VM_VPN_BASE_MARKER:-${CONFIG_ROOT}/.base-image-ready}"

fail() {
	printf 'vm: %s\n' "$*" >&2
	exit 1
}

require_command() {
	local command_name="$1"
	command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required; run direnv allow"
}

validate_component() {
	local label="$1"
	local value="$2"
	[[ "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
		fail "$label must contain lowercase letters, numbers, and single hyphens"
}

workspace_path() {
	local product="$1"
	local environment="$2"
	validate_component product "$product"
	validate_component environment "$environment"
	printf '%s/%s/%s\n' "$CONFIG_ROOT" "$product" "$environment"
}

instance_name() {
	local product="$1"
	local environment="$2"
	local encoded_product encoded_environment
	validate_component product "$product"
	validate_component environment "$environment"
	encoded_product="${product//-/_}"
	encoded_environment="${environment//-/_}"
	printf '%s%s-%s\n' "$INSTANCE_PREFIX" "$encoded_product" "$encoded_environment"
}

appearance_color() {
	case "$1" in
	dev) printf '#7895A8\n' ;;
	staging) printf '#5F7F95\n' ;;
	prod) printf '#465F70\n' ;;
	hybridtest) printf '#B77A7A\n' ;;
	preprod) printf '#965E5E\n' ;;
	awsgov-prod) printf '#744747\n' ;;
	*) printf '#374151\n' ;;
	esac
}

is_legacy_appearance_color() {
	case "$1:$2" in
	dev:#2563EB | dev:#0EA5E9 | \
		staging:#D97706 | staging:#2563EB | \
		prod:#B91C1C | prod:#1E3A8A | \
		hybridtest:#0F766E | hybridtest:#FB7185 | \
		preprod:#C2410C | preprod:#DC2626 | \
		awsgov-prod:#6D28D9 | awsgov-prod:#7F1D1D) return 0 ;;
	*) return 1 ;;
	esac
}

write_appearance() {
	local config_path="$1"
	local environment="$2"
	local wallpaper_color
	wallpaper_color="$(appearance_color "$environment")"
	printf '{\n  "wallpaperColor": "%s"\n}\n' "$wallpaper_color" >"$config_path/appearance.json"
	chmod 0600 "$config_path/appearance.json"
}

migrate_appearance() {
	local config_path="$1"
	local environment="$2"
	local appearance_file="${config_path}/appearance.json"
	local current_color
	[[ -f "$appearance_file" ]] || return 0
	current_color="$(jq -r '.wallpaperColor // empty' "$appearance_file" 2>/dev/null || true)"
	if is_legacy_appearance_color "$environment" "$current_color"; then
		write_appearance "$config_path" "$environment"
	fi
}

initialize_workspace() {
	local config_path="$1"
	local environment="$2"
	umask 077
	install -d -m 0700 "$config_path" "$config_path/vpn" "$config_path/bookmarks" "$config_path/shared"
	write_appearance "$config_path" "$environment"
	cat >"$config_path/bookmarks/bookmarks.json" <<'EOF'
[
  {
    "title": "Company documentation",
    "url": "https://docs.example.com/"
  },
  {
    "title": "Service dashboard",
    "url": "https://dashboard.example.com/"
  }
]
EOF
	chmod 0600 "$config_path/bookmarks/bookmarks.json"
}

require_workspace() {
	local product="$1"
	local environment="$2"
	local config_path
	config_path="$(workspace_path "$product" "$environment")"
	[[ -d "$config_path" ]] || fail "configuration is missing; run: task create -- $product $environment"
	printf '%s\n' "$config_path"
}

bookmarks_state() {
	local config_path="$1"
	local bookmarks_file="${config_path}/bookmarks/bookmarks.json"
	if [[ ! -f "$bookmarks_file" ]]; then
		printf 'missing\n'
	elif jq -e 'type == "array" and all(.[]; (.title | type == "string") and (.url | type == "string"))' \
		"$bookmarks_file" >/dev/null 2>&1; then
		printf 'valid\n'
	else
		printf 'invalid\n'
	fi
}

appearance_state() {
	local config_path="$1"
	local appearance_file="${config_path}/appearance.json"
	if [[ ! -f "$appearance_file" ]]; then
		printf 'missing\n'
	elif jq -e '.wallpaperColor | type == "string" and test("^#[0-9A-Fa-f]{6}$")' \
		"$appearance_file" >/dev/null 2>&1; then
		printf 'valid\n'
	else
		printf 'invalid\n'
	fi
}

vpn_state() {
	local config_path="$1"
	local vpn_profile
	for vpn_profile in "${config_path}"/vpn/*.ovpn; do
		if [[ -s "$vpn_profile" ]]; then
			printf 'present\n'
			return 0
		fi
	done
	printf 'missing\n'
}

vpn_profile_count() {
	local config_path="$1"
	local count=0
	local vpn_profile
	for vpn_profile in "${config_path}"/vpn/*.ovpn; do
		[[ -s "$vpn_profile" ]] || continue
		((count += 1))
	done
	printf '%d\n' "$count"
}

runtime_state() {
	local vm_name="$1"
	local details
	if ! details="$(tart get "$vm_name" 2>/dev/null)"; then
		printf 'not-created\n'
		return 0
	fi
	printf '%s\n' "$details" | tail -n 1 | awk '{ print $NF }'
}

base_image_is_verified() {
	[[ -f "$BASE_MARKER" ]] && [[ "$(<"$BASE_MARKER")" == "verified:${BASE_IMAGE_VERSION}" ]]
}

require_base_image() {
	tart get "$BASE_VM_NAME" >/dev/null 2>&1 || fail "runtime image is unavailable; run: task setup"
	base_image_is_verified || fail "base image exists but is not verified; rebuild it with: task image:build"
}

create_config() {
	local config_path
	config_path="$(workspace_path "$1" "$2")"
	[[ ! -e "$config_path" ]] || fail "configuration already exists: $1/$2"
	initialize_workspace "$config_path" "$2"
	printf 'created configuration %s/%s at %s\n' "$1" "$2" "$config_path"
}

start_config() {
	local product="$1"
	local environment="$2"
	local config_path vm_name bookmark_status appearance_status vpn_count
	config_path="$(require_workspace "$product" "$environment")"
	migrate_appearance "$config_path" "$environment"
	if [[ "$(appearance_state "$config_path")" == "missing" ]]; then
		write_appearance "$config_path" "$environment"
	fi
	appearance_status="$(appearance_state "$config_path")"
	[[ "$appearance_status" == "valid" ]] || fail "appearance is $appearance_status; fix: $config_path/appearance.json"
	bookmark_status="$(bookmarks_state "$config_path")"
	[[ "$bookmark_status" == "valid" ]] || fail "bookmarks are $bookmark_status; run: task validate -- $product $environment"
	vpn_count="$(vpn_profile_count "$config_path")"
	printf 'config: %s/%s\nappearance: %s\nbookmarks: %s\nvpn profiles: %s\n' \
		"$product" "$environment" "$appearance_status" "$bookmark_status" "$vpn_count"
	vm_name="$(instance_name "$product" "$environment")"
	require_command tart
	require_base_image
	if ! tart get "$vm_name" >/dev/null 2>&1; then
		printf 'runtime: creating from shared image\n'
		tart clone "$BASE_VM_NAME" "$vm_name"
	else
		printf 'runtime: reusing existing runtime\n'
	fi
	printf 'runtime: starting\nbootstrap logs: task logs -- %s %s\n' "$product" "$environment"
	exec tart run "$vm_name" --dir "workspace:$config_path:ro"
}

stop_config() {
	local vm_name
	vm_name="$(instance_name "$1" "$2")"
	require_workspace "$1" "$2" >/dev/null
	require_command tart
	tart get "$vm_name" >/dev/null 2>&1 || fail "configuration is not running and has no runtime"
	tart stop "$vm_name"
}

logs_config() {
	local vm_name
	vm_name="$(instance_name "$1" "$2")"
	require_workspace "$1" "$2" >/dev/null
	require_command tart
	tart get "$vm_name" >/dev/null 2>&1 || fail "configuration has no runtime; run: task start -- $1 $2"
	exec tart exec "$vm_name" /usr/bin/tail -n 200 -f \
		/Users/admin/Library/Logs/vm-vpn-bootstrap.log \
		/Users/admin/Library/Logs/vm-vpn-bootstrap.error.log
}

delete_config() {
	local product="$1"
	local environment="$2"
	local config_path vm_name
	config_path="$(require_workspace "$product" "$environment")"
	vm_name="$(instance_name "$product" "$environment")"
	require_command tart
	if tart get "$vm_name" >/dev/null 2>&1; then
		tart stop "$vm_name" >/dev/null 2>&1 || true
		tart delete "$vm_name"
	fi
	rm -rf -- "$config_path"
	printf 'deleted configuration %s/%s and its runtime\n' "$product" "$environment"
}

validate_config() {
	local product="$1"
	local environment="$2"
	local config_path bookmark_status vpn_status
	config_path="$(require_workspace "$product" "$environment")"
	bookmark_status="$(bookmarks_state "$config_path")"
	vpn_status="$(vpn_state "$config_path")"
	printf 'config: %s/%s\nbookmarks: %s\nvpn: %s\npath: %s\n' \
		"$product" "$environment" "$bookmark_status" "$vpn_status" "$config_path"
	[[ "$bookmark_status" == "valid" ]]
}

status_config() {
	local product="$1"
	local environment="$2"
	local config_path vm_name
	config_path="$(require_workspace "$product" "$environment")"
	vm_name="$(instance_name "$product" "$environment")"
	require_command tart
	printf 'config: %s/%s\nruntime: %s\nvpn: %s\nbookmarks: %s\npath: %s\n' \
		"$product" "$environment" "$(runtime_state "$vm_name")" "$(vpn_state "$config_path")" \
		"$(bookmarks_state "$config_path")" "$config_path"
}

list_configs() {
	require_command tart
	printf 'CONFIG\tSTATE\tVPN\tBOOKMARKS\n'
	[[ -d "$CONFIG_ROOT" ]] || return 0

	local product_path environment_path product environment vm_name
	shopt -s nullglob
	for product_path in "$CONFIG_ROOT"/*; do
		[[ -d "$product_path" ]] || continue
		product="${product_path##*/}"
		[[ "$product" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || continue
		for environment_path in "$product_path"/*; do
			[[ -d "$environment_path" ]] || continue
			environment="${environment_path##*/}"
			[[ "$environment" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || continue
			vm_name="$(instance_name "$product" "$environment")"
			printf '%s/%s\t%s\t%s\t%s\n' "$product" "$environment" "$(runtime_state "$vm_name")" \
				"$(vpn_state "$environment_path")" "$(bookmarks_state "$environment_path")"
		done
	done
}

stop_all() {
	require_command tart
	local vm_name
	while IFS= read -r vm_name; do
		[[ -n "$vm_name" ]] && tart stop "$vm_name"
	done < <(managed_instance_names)
}

managed_instance_names() {
	tart list | awk -v prefix="$INSTANCE_PREFIX" '
    {
      for (field = 1; field <= NF; field++) {
        identity = substr($field, length(prefix) + 1)
        if (index($field, prefix) == 1 && $field != "vm-vpn-base" && index(identity, "-") > 0) {
          print $field
        }
      }
    }
  '
}

clean_orphans() {
	require_command tart
	local vm_name identity product environment config_path
	while IFS= read -r vm_name; do
		[[ -n "$vm_name" ]] || continue
		identity="${vm_name#"$INSTANCE_PREFIX"}"
		product="${identity%%-*}"
		environment="${identity#*-}"
		product="${product//_/-}"
		environment="${environment//_/-}"
		config_path="$(workspace_path "$product" "$environment")"
		[[ -d "$config_path" ]] && continue
		tart stop "$vm_name" >/dev/null 2>&1 || true
		tart delete "$vm_name"
		printf 'deleted orphan runtime for %s/%s\n' "$product" "$environment"
	done < <(managed_instance_names)
}

delete_managed_runtimes() {
	local vm_name identity product environment
	while IFS= read -r vm_name; do
		[[ -n "$vm_name" ]] || continue
		tart stop "$vm_name" >/dev/null 2>&1 || true
		tart delete "$vm_name"
		identity="${vm_name#"$INSTANCE_PREFIX"}"
		product="${identity%%-*}"
		environment="${identity#*-}"
		product="${product//_/-}"
		environment="${environment//_/-}"
		printf 'runtime: removed old runtime for %s/%s; next start will recreate it from the new base image\n' \
			"$product" "$environment"
	done < <(managed_instance_names)
}

seed_demo() {
	local product="$1"
	local environment="$2"
	[[ "$product/$environment" == "demo/dev" ]] || fail "only demo/dev has tracked example data"
	local config_path
	config_path="$(require_workspace "$product" "$environment")"
	cp "${REPO_ROOT}/examples/demo/dev/vpn/profile.ovpn" "$config_path/vpn/profile.ovpn"
	cp "${REPO_ROOT}/examples/demo/dev/bookmarks/bookmarks.json" "$config_path/bookmarks/bookmarks.json"
	cp "${REPO_ROOT}/examples/demo/dev/certs/demo-ca.crt" "$config_path/shared/demo-ca.crt"
	chmod 0600 "$config_path/vpn/profile.ovpn" "$config_path/bookmarks/bookmarks.json" "$config_path/shared/demo-ca.crt"
	printf 'seeded demo/dev at %s\n' "$config_path"
}

build_image() {
	[[ -x "$BUILD_SCRIPT" ]] || fail "build script is not executable: $BUILD_SCRIPT"
	require_command tart
	if tart get "$BASE_VM_NAME" >/dev/null 2>&1; then
		tart stop "$BASE_VM_NAME" >/dev/null 2>&1 || true
		tart delete "$BASE_VM_NAME"
	fi
	"$BUILD_SCRIPT" "$BASE_VM_NAME"
	umask 077
	install -d -m 0700 "$(dirname "$BASE_MARKER")"
	printf 'verified:%s\n' "$BASE_IMAGE_VERSION" >"$BASE_MARKER"
	chmod 0600 "$BASE_MARKER"
	delete_managed_runtimes
}

setup_runtime() {
	require_command tart
	if tart get "$BASE_VM_NAME" >/dev/null 2>&1; then
		if base_image_is_verified; then
			printf 'runtime image is ready\n'
			return 0
		fi
		printf 'runtime: replacing unverified base image\n'
		tart stop "$BASE_VM_NAME" >/dev/null 2>&1 || true
		tart delete "$BASE_VM_NAME"
	fi
	build_image
}

image_status() {
	require_command tart
	tart get "$BASE_VM_NAME"
}

doctor() {
	local command_name
	for command_name in bats direnv jq nix packer shellcheck shfmt sshpass tart task; do
		require_command "$command_name"
	done
	printf 'vm: development environment is ready\n'
}

main() {
	local command_name="${1:-}"
	case "$command_name" in
	create)
		[[ $# -eq 3 ]] || fail "usage: task create -- <product> <environment>"
		create_config "$2" "$3"
		;;
	start)
		[[ $# -eq 3 ]] || fail "usage: task start -- <product> <environment>"
		start_config "$2" "$3"
		;;
	stop)
		[[ $# -eq 3 ]] || fail "usage: task stop -- <product> <environment>"
		stop_config "$2" "$3"
		;;
	logs)
		[[ $# -eq 3 ]] || fail "usage: task logs -- <product> <environment>"
		logs_config "$2" "$3"
		;;
	delete)
		[[ $# -eq 3 ]] || fail "usage: task delete -- <product> <environment>"
		delete_config "$2" "$3"
		;;
	status)
		[[ $# -eq 3 ]] || fail "usage: task status -- <product> <environment>"
		status_config "$2" "$3"
		;;
	validate)
		[[ $# -eq 3 ]] || fail "usage: task validate -- <product> <environment>"
		validate_config "$2" "$3"
		;;
	path)
		[[ $# -eq 3 ]] || fail "usage: task path -- <product> <environment>"
		workspace_path "$2" "$3"
		;;
	list)
		[[ $# -eq 1 ]] || fail "usage: task list"
		list_configs
		;;
	stop-all)
		[[ $# -eq 1 ]] || fail "usage: task stop-all"
		stop_all
		;;
	clean)
		[[ $# -eq 1 ]] || fail "usage: task clean"
		clean_orphans
		;;
	seed)
		[[ $# -eq 3 ]] || fail "usage: task seed -- demo dev"
		seed_demo "$2" "$3"
		;;
	setup)
		[[ $# -eq 1 ]] || fail "usage: task setup"
		setup_runtime
		;;
	image-build)
		[[ $# -eq 1 ]] || fail "usage: task image:build"
		build_image
		;;
	image-status)
		[[ $# -eq 1 ]] || fail "usage: task image:status"
		image_status
		;;
	doctor)
		[[ $# -eq 1 ]] || fail "usage: task doctor"
		doctor
		;;
	*)
		fail "unknown internal command: ${command_name:-<empty>}; run task help"
		;;
	esac
}

main "$@"
