#!/usr/bin/env bash

set -euo pipefail

readonly BASE_VM_NAME="vm-vpn-base"
readonly INSTANCE_PREFIX="vm-vpn-"
REPO_ROOT="${VM_VPN_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
readonly REPO_ROOT
readonly CONFIG_ROOT="${VM_VPN_CONFIG_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/vm-vpn}"
readonly BUILD_SCRIPT="${VM_VPN_BUILD_SCRIPT:-${REPO_ROOT}/macos/scripts/build-image}"

usage() {
	cat <<'EOF'
Usage:
  vm build
  vm create <product> <environment>
  vm start <product> <environment>
  vm stop <product> <environment>
  vm delete <product> <environment>
  vm status <product> <environment>
  vm list
  vm stop-all
  vm seed demo dev
  vm config-path <product> <environment>
  vm doctor
  vm check
  vm --help

The command builds one reusable Tart image named vm-vpn-base. Each create
clones that base into vm-vpn-<product>-<environment>. Instances can start
concurrently with separate ~/.config/vm-vpn/<product>/<environment> mounts.
EOF
}

fail() {
	printf 'vm: %s\n' "$*" >&2
	exit 1
}

require_command() {
	local command_name="$1"
	command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required; run direnv allow"
}

validate_component() {
	local label="$1"
	local value="$2"
	[[ "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
		fail "$label must contain lowercase letters, numbers, and single hyphens"
}

workspace_path() {
	local product="$1"
	local environment="$2"
	validate_component product "$product"
	validate_component environment "$environment"
	printf '%s/%s/%s\n' "$CONFIG_ROOT" "$product" "$environment"
}

instance_name() {
	local product="$1"
	local environment="$2"
	validate_component product "$product"
	validate_component environment "$environment"
	printf '%s%s-%s\n' "$INSTANCE_PREFIX" "$product" "$environment"
}

initialize_workspace() {
	local config_path="$1"
	umask 077
	install -d -m 0700 "$config_path" "$config_path/vpn" "$config_path/bookmarks" "$config_path/shared"
	if [[ ! -f "$config_path/bookmarks/bookmarks.json" ]]; then
		printf '[]\n' >"$config_path/bookmarks/bookmarks.json"
		chmod 0600 "$config_path/bookmarks/bookmarks.json"
	fi
}

require_workspace() {
	local product="$1"
	local environment="$2"
	local config_path
	config_path="$(workspace_path "$product" "$environment")"
	[[ -d "$config_path" ]] || fail "configuration is missing; run: vm create $product $environment"
	[[ -f "$config_path/bookmarks/bookmarks.json" ]] ||
		fail "bookmarks file is missing: $config_path/bookmarks/bookmarks.json"
	jq -e 'type == "array" and all(.[]; (.title | type == "string") and (.url | type == "string"))' \
		"$config_path/bookmarks/bookmarks.json" >/dev/null || fail "bookmarks.json has an invalid format"
	printf '%s\n' "$config_path"
}

build_vm() {
	[[ -x "$BUILD_SCRIPT" ]] || fail "build script is not executable: $BUILD_SCRIPT"
	"$BUILD_SCRIPT" "$BASE_VM_NAME"
}

create_vm() {
	local product="$1"
	local environment="$2"
	local config_path vm_name
	config_path="$(workspace_path "$product" "$environment")"
	vm_name="$(instance_name "$product" "$environment")"
	require_command tart
	tart get "$BASE_VM_NAME" >/dev/null 2>&1 || fail "base VM is missing; run: vm build"
	if tart get "$vm_name" >/dev/null 2>&1; then
		fail "$vm_name already exists"
	fi
	initialize_workspace "$config_path"
	tart clone "$BASE_VM_NAME" "$vm_name"
	printf 'created %s with configuration at %s\n' "$vm_name" "$config_path"
}

start_vm() {
	local product="$1"
	local environment="$2"
	local config_path vm_name
	config_path="$(require_workspace "$product" "$environment")"
	vm_name="$(instance_name "$product" "$environment")"
	require_command tart
	tart get "$vm_name" >/dev/null 2>&1 || fail "VM is missing; run: vm create $product $environment"
	printf 'starting %s with %s/%s\n' "$vm_name" "$product" "$environment"
	exec tart run "$vm_name" --dir "$config_path:ro,tag=workspace"
}

stop_vm() {
	local vm_name
	vm_name="$(instance_name "$1" "$2")"
	require_command tart
	tart get "$vm_name" >/dev/null 2>&1 || fail "VM is missing: $vm_name"
	tart stop "$vm_name"
}

delete_vm() {
	local vm_name
	vm_name="$(instance_name "$1" "$2")"
	require_command tart
	tart get "$vm_name" >/dev/null 2>&1 || fail "VM is missing: $vm_name"
	tart stop "$vm_name" >/dev/null 2>&1 || true
	tart delete "$vm_name"
	printf 'deleted %s; host configuration was preserved\n' "$vm_name"
}

status_vm() {
	local vm_name
	vm_name="$(instance_name "$1" "$2")"
	require_command tart
	tart get "$vm_name"
}

list_vms() {
	require_command tart
	tart list | awk -v prefix="$INSTANCE_PREFIX" '{ for (field = 1; field <= NF; field++) if (index($field, prefix) == 1 && $field != "vm-vpn-base") print $0 }'
}

stop_all() {
	require_command tart
	local vm_name
	while IFS= read -r vm_name; do
		[[ -n "$vm_name" ]] && tart stop "$vm_name"
	done < <(tart list | awk -v prefix="$INSTANCE_PREFIX" '{ for (field = 1; field <= NF; field++) if (index($field, prefix) == 1 && $field != "vm-vpn-base") print $field }')
}

seed_demo() {
	local product="$1"
	local environment="$2"
	[[ "$product/$environment" == "demo/dev" ]] || fail "only demo/dev has tracked example data"
	local config_path
	config_path="$(workspace_path "$product" "$environment")"
	[[ -d "$config_path" ]] || fail "configuration is missing; run: vm create demo dev"
	cp "${REPO_ROOT}/examples/demo/dev/vpn/profile.ovpn" "$config_path/vpn/profile.ovpn"
	cp "${REPO_ROOT}/examples/demo/dev/bookmarks/bookmarks.json" "$config_path/bookmarks/bookmarks.json"
	cp "${REPO_ROOT}/examples/demo/dev/certs/demo-ca.crt" "$config_path/shared/demo-ca.crt"
	chmod 0600 "$config_path/vpn/profile.ovpn" "$config_path/bookmarks/bookmarks.json" "$config_path/shared/demo-ca.crt"
	printf 'seeded demo/dev at %s\n' "$config_path"
}

doctor() {
	local command_name
	for command_name in bats direnv jq nix packer shellcheck shfmt sshpass tart; do
		require_command "$command_name"
	done
	printf 'vm: development environment is ready\n'
}

main() {
	local command_name="${1:---help}"
	case "$command_name" in
	-h | --help | help)
		usage
		;;
	build)
		[[ $# -eq 1 ]] || fail "usage: vm build"
		build_vm
		;;
	create)
		[[ $# -eq 3 ]] || fail "usage: vm create <product> <environment>"
		create_vm "$2" "$3"
		;;
	start)
		[[ $# -eq 3 ]] || fail "usage: vm start <product> <environment>"
		start_vm "$2" "$3"
		;;
	stop)
		[[ $# -eq 3 ]] || fail "usage: vm stop <product> <environment>"
		stop_vm "$2" "$3"
		;;
	delete)
		[[ $# -eq 3 ]] || fail "usage: vm delete <product> <environment>"
		delete_vm "$2" "$3"
		;;
	status)
		[[ $# -eq 3 ]] || fail "usage: vm status <product> <environment>"
		status_vm "$2" "$3"
		;;
	list)
		[[ $# -eq 1 ]] || fail "usage: vm list"
		list_vms
		;;
	stop-all)
		[[ $# -eq 1 ]] || fail "usage: vm stop-all"
		stop_all
		;;
	seed)
		[[ $# -eq 3 ]] || fail "usage: vm seed demo dev"
		seed_demo "$2" "$3"
		;;
	config-path)
		[[ $# -eq 3 ]] || fail "usage: vm config-path <product> <environment>"
		workspace_path "$2" "$3"
		;;
	doctor)
		[[ $# -eq 1 ]] || fail "usage: vm doctor"
		doctor
		;;
	check)
		[[ $# -eq 1 ]] || fail "usage: vm check"
		"${REPO_ROOT}/scripts/ci-check"
		;;
	*)
		fail "unknown command: $command_name"
		;;
	esac
}

main "$@"
