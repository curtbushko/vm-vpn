#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  vm --help
  vm identity PRODUCT ENVIRONMENT
  vm init PRODUCT ENVIRONMENT
  vm seed PRODUCT ENVIRONMENT
  vm import-vpn PRODUCT ENVIRONMENT SOURCE
  vm import-bookmarks PRODUCT ENVIRONMENT SOURCE
  vm import-cert PRODUCT ENVIRONMENT SOURCE
  vm preflight PRODUCT ENVIRONMENT
  vm materialize PRODUCT ENVIRONMENT
  vm list
  vm up|down|restart|status PRODUCT ENVIRONMENT
  vm rebuild PRODUCT ENVIRONMENT
  vm diagnose PRODUCT ENVIRONMENT
  vm cleanup PRODUCT ENVIRONMENT
  vm share-add PRODUCT ENVIRONMENT NAME HOST_PATH [--read-write]
  vm share-list PRODUCT ENVIRONMENT
  vm share-remove PRODUCT ENVIRONMENT NAME
  vm check
  vm doctor

Phase 1 exposes identity and host prerequisite checks. Lifecycle commands are
added only after the Tart and NixOS vertical slice is proven.
EOF
}

data_root() {
	printf '%s\n' "${VM_VPN_DATA_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}/vm-vpn}"
}

workspace_dir() {
	printf '%s/%s/%s\n' "$(data_root)" "$1" "$2"
}

validate_workspace() {
	validate_name "PRODUCT" "$1"
	validate_name "ENVIRONMENT" "$2"
	if ! nix eval --json "${VM_VPN_REPO_ROOT:-$PWD}#workspaceRegistry" |
		jq -e --arg key "$1/$2" 'has($key)' >/dev/null; then
		fail "workspace is not configured: $1/$2"
	fi
}

init_workspace() {
	validate_workspace "$1" "$2"
	local root
	root="$(workspace_dir "$1" "$2")"
	umask 077
	mkdir -p "$root/vpn" "$root/bookmarks" "$root/certs"
	chmod 0700 "$root" "$root/vpn" "$root/bookmarks" "$root/certs"
	printf 'initialized %s/%s\n' "$1" "$2"
}

seed_workspace() {
	local product="$1" environment="$2" repository fixture root output config
	validate_workspace "$product" "$environment"
	repository="${VM_VPN_REPO_ROOT:-$PWD}"
	fixture="$repository/examples/$product/$environment"
	[[ -f "$fixture/vpn/profile.ovpn" ]] || fail "seed fixtures are not available for $product/$environment"
	[[ -f "$fixture/bookmarks/bookmarks.json" ]] || fail "seed bookmark fixture is missing"
	[[ -f "$fixture/certs/demo-ca.crt" ]] || fail "seed certificate fixture is missing"

	init_workspace "$product" "$environment" >/dev/null
	root="$(workspace_dir "$product" "$environment")"
	output="$root/output"
	umask 077
	mkdir -p "$output"
	chmod 0700 "$output"

	local source destination
	for source in \
		"$fixture/vpn/profile.ovpn" \
		"$fixture/bookmarks/bookmarks.json" \
		"$fixture/certs/demo-ca.crt"; do
		case "$source" in
		*/vpn/*) destination="$root/vpn/profile.ovpn" ;;
		*/bookmarks/*) destination="$root/bookmarks/bookmarks.json" ;;
		*/certs/*) destination="$root/certs/demo-ca.crt" ;;
		esac
		if [[ -f "$destination" ]]; then
			cmp -s "$source" "$destination" || fail "seed destination already contains different data"
		else
			cp "$source" "$destination"
		fi
		chmod 0600 "$destination"
	done

	config="$(share_config_file "$product" "$environment")"
	seed_share "$product" "$environment" examples "$fixture/shared" ro "$config"
	seed_share "$product" "$environment" output "$output" rw "$config"
	printf 'seeded example workspace %s/%s\n' "$product" "$environment"
}

seed_share() {
	local product="$1" environment="$2" name="$3" path="$4" mode="$5" config="$6"
	path="$(realpath "$path")"
	if [[ -f "$config" ]] && jq -e --arg name "$name" 'any(.[]; .name == $name)' "$config" >/dev/null; then
		jq -e --arg name "$name" --arg path "$path" --arg mode "$mode" \
			'any(.[]; .name == $name and .path == $path and .mode == $mode)' "$config" >/dev/null ||
			fail "seed share $name already has different settings"
	elif [[ "$mode" == "rw" ]]; then
		share_add "$product" "$environment" "$name" "$path" --read-write >/dev/null
	else
		share_add "$product" "$environment" "$name" "$path" >/dev/null
	fi
}

import_file() {
	local kind="$1"
	local product="$2"
	local environment="$3"
	local source="$4"
	validate_workspace "$product" "$environment"
	[[ -f "$source" ]] || fail "source file is missing"
	local root destination
	root="$(workspace_dir "$product" "$environment")"
	case "$kind" in
	vpn) destination="$root/vpn/profile.ovpn" ;;
	bookmarks) destination="$root/bookmarks/bookmarks.json" ;;
	cert) destination="$root/certs/$(basename "$source")" ;;
	esac
	[[ ! -e "$destination" ]] || fail "$kind destination already exists"
	umask 077
	mkdir -p "$(dirname "$destination")"
	cp "$source" "$destination"
	chmod 0600 "$destination"
	printf 'imported %s for %s/%s\n' "$kind" "$product" "$environment"
}

preflight() {
	validate_workspace "$1" "$2"
	local root profile
	root="$(workspace_dir "$1" "$2")"
	profile="$root/vpn/profile.ovpn"
	[[ -f "$profile" ]] || fail "VPN profile is missing; run vm import-vpn"
	[[ "$(stat -c '%a' "$root")" == "700" ]] || fail "workspace permissions must be 0700"
	[[ "$(stat -c '%a' "$profile")" == "600" ]] || fail "VPN profile permissions must be 0600"
	printf 'preflight passed for %s/%s\n' "$1" "$2"
}

list_workspaces() {
	nix eval --json "${VM_VPN_REPO_ROOT:-$PWD}#workspaceRegistry" | jq -c 'to_entries[] | .value'
}

tart_command() {
	"${TART_BIN:-tart}" "$@"
}

state_dir() {
	printf '%s/%s/%s\n' "${VM_VPN_STATE_HOME:-${XDG_STATE_HOME:-${HOME}/.local/state}/vm-vpn}" "$1" "$2"
}

config_dir() {
	printf '%s/%s/%s\n' "${VM_VPN_CONFIG_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/vm-vpn}" "$1" "$2"
}

share_config_file() {
	printf '%s/shares.json\n' "$(config_dir "$1" "$2")"
}

share_add() {
	local product="$1" environment="$2" name="$3" host_path="$4" mode="ro"
	validate_workspace "$product" "$environment"
	if [[ "$#" -eq 5 ]]; then
		[[ "$5" == "--read-write" ]] || fail "unknown share option: $5"
		mode="rw"
	fi
	[[ "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "share name must be lowercase hostname-safe text"
	[[ "$name" != "repo" ]] || fail "share name repo is reserved"
	[[ "$host_path" == /* ]] || fail "host share path must be absolute"
	[[ -d "$host_path" ]] || fail "host share path is not a directory"
	[[ "$host_path" != *:* && "$host_path" != *$'\t'* && "$host_path" != *$'\n'* ]] || fail "host share path contains unsupported characters"
	host_path="$(realpath "$host_path")"

	local directory config temporary
	directory="$(config_dir "$product" "$environment")"
	config="$(share_config_file "$product" "$environment")"
	umask 077
	mkdir -p "$directory"
	chmod 0700 "$directory"
	if [[ ! -f "$config" ]]; then
		printf '[]\n' >"$config"
		chmod 0600 "$config"
	fi
	if jq -e --arg name "$name" 'any(.[]; .name == $name)' "$config" >/dev/null; then
		fail "share name is already configured"
	fi
	temporary="$(mktemp "$directory/.shares.XXXXXX")"
	jq --arg name "$name" --arg path "$host_path" --arg mode "$mode" \
		'. + [{name: $name, path: $path, mode: $mode}]' "$config" >"$temporary"
	chmod 0600 "$temporary"
	mv "$temporary" "$config"
	printf 'configured share %s for %s/%s (%s)\n' "$name" "$product" "$environment" "$mode"
}

share_list() {
	validate_workspace "$1" "$2"
	local config
	config="$(share_config_file "$1" "$2")"
	if [[ -f "$config" ]]; then
		jq -c '.' "$config"
	else
		printf '[]\n'
	fi
}

share_remove() {
	validate_workspace "$1" "$2"
	local config directory temporary
	config="$(share_config_file "$1" "$2")"
	directory="$(config_dir "$1" "$2")"
	[[ -f "$config" ]] || fail "share name is not configured"
	if ! jq -e --arg name "$3" 'any(.[]; .name == $name)' "$config" >/dev/null; then
		fail "share name is not configured"
	fi
	temporary="$(mktemp "$directory/.shares.XXXXXX")"
	jq --arg name "$3" 'map(select(.name != $name))' "$config" >"$temporary"
	chmod 0600 "$temporary"
	mv "$temporary" "$config"
	printf 'removed share setting %s for %s/%s\n' "$3" "$1" "$2"
}

prepare_source_snapshot() {
	local root revision snapshot
	root="${VM_VPN_REPO_ROOT:-$PWD}"
	revision="$(git -C "$root" rev-parse HEAD)"
	snapshot="$(state_dir "$1" "$2")/sources/$revision"
	if [[ ! -d "$snapshot" ]]; then
		umask 077
		mkdir -p "$snapshot"
		git -C "$root" archive "$revision" | tar -C "$snapshot" -xf -
	fi
	printf '%s\n' "$snapshot"
}

vm_exists() {
	tart_command get "$1" >/dev/null 2>&1
}

vm_create() {
	local product="$1" environment="$2" name iso snapshot state_root
	name="$product-$environment"
	iso="${VM_VPN_INSTALLER_ISO:-}"
	[[ -f "$iso" ]] || fail "VM_VPN_INSTALLER_ISO must name the built installer ISO"
	snapshot="$(prepare_source_snapshot "$product" "$environment")"
	state_root="$(state_dir "$product" "$environment")"
	mkdir -p "$state_root"
	tart_command create --linux "$name" --disk-size 80
	tart_command set "$name" --cpu 6 --memory 16384 --display 1440x900 --display-refit
	(tart_command run "$name" --no-graphics --disk "$iso:ro" --dir "$snapshot:ro,tag=repo" >>"$state_root/installer.log" 2>&1 &)
	for _ in {1..60}; do
		# shellcheck disable=SC2016 # Expand resume inside the guest shell.
		if tart_command exec "$name" /run/current-system/sw/bin/bash -lc \
			'set -e; mkdir -p /mnt/shared/repo; mountpoint -q /mnt/shared/repo || mount -t virtiofs repo /mnt/shared/repo; resume=; if mountpoint -q /mnt && mountpoint -q /mnt/boot; then resume=--resume; fi; /mnt/shared/repo/scripts/install-demo-dev --device /dev/vda --repo /mnt/shared/repo $resume --yes'; then
			tart_command stop "$name"
			printf 'created %s\n' "$name"
			return 0
		fi
		sleep 2
	done
	fail "installer did not become ready; VM retained for recovery"
}

vm_status() {
	validate_workspace "$1" "$2"
	local name state
	name="$1-$2"
	if state="$(tart_command get "$name" 2>/dev/null | awk 'END { print $NF }')"; then
		local vpn_state="stopped"
		if tart_command exec "$name" /run/current-system/sw/bin/test -f /run/vpn-workspace/vpn/profile.ovpn >/dev/null 2>&1; then
			vpn_state="ready"
		fi
		printf 'VM_NAME=%s\nVM_STATE=%s\nVPN_STATE=%s\n' "$name" "${state:-available}" "$vpn_state"
	else
		printf 'VM_NAME=%s\nVM_STATE=absent\nVPN_STATE=stopped\n' "$name"
	fi
}

vm_down() {
	validate_workspace "$1" "$2"
	tart_command stop "$1-$2"
	printf 'stopped %s-%s\n' "$1" "$2"
}

vm_start() {
	validate_workspace "$1" "$2"
	local name state_root snapshot config share_name share_path share_mode tart_bin daemonize_bin
	local -a share_args
	name="$1-$2"
	state_root="$(state_dir "$1" "$2")"
	snapshot="$(prepare_source_snapshot "$1" "$2")"
	share_args=(--dir "$snapshot:ro,tag=repo")
	config="$(share_config_file "$1" "$2")"
	if [[ -f "$config" ]]; then
		while IFS=$'\t' read -r share_name share_path share_mode; do
			if [[ "$share_mode" == "ro" ]]; then
				share_args+=(--dir "$share_path:ro,tag=vm-vpn-$share_name")
			else
				share_args+=(--dir "$share_path:tag=vm-vpn-$share_name")
			fi
		done < <(jq -r '.[] | [.name, .path, .mode] | @tsv' "$config")
	fi
	umask 077
	mkdir -p "$state_root"
	tart_bin="${TART_BIN:-$(command -v tart)}"
	daemonize_bin="${DAEMONIZE_BIN:-$(command -v daemonize)}"
	"$daemonize_bin" -a -o "$state_root/tart.log" -e "$state_root/tart.log" \
		-p "$state_root/tart.pid" "$tart_bin" run "$name" --no-audio "${share_args[@]}"
	printf 'started %s\n' "$name"
}

mount_configured_shares() {
	local product="$1" environment="$2" name="$1-$2" config share_name
	tart_command exec "$name" /run/current-system/sw/bin/bash -lc \
		'set -e; mkdir -p /mnt/shared/repo; mountpoint -q /mnt/shared/repo || mount -t virtiofs repo /mnt/shared/repo; test -f /mnt/shared/repo/flake.nix' || return 1
	config="$(share_config_file "$product" "$environment")"
	if [[ -f "$config" ]]; then
		while IFS=$'\t' read -r share_name share_mode; do
			# shellcheck disable=SC2016 # Positional expansion belongs in the guest shell.
			tart_command exec "$name" /run/current-system/sw/bin/bash -lc \
				'set -e; mkdir -p "/mnt/shared/$1"; mountpoint -q "/mnt/shared/$1" || mount -t virtiofs "vm-vpn-$1" "/mnt/shared/$1"' _ "$share_name" "$share_mode" || return 1
		done < <(jq -r '.[] | [.name, .mode] | @tsv' "$config")
	fi
}

wait_for_shares() {
	for _ in {1..30}; do
		if mount_configured_shares "$1" "$2"; then
			return 0
		fi
		sleep 1
	done
	fail "guest did not become ready for configured shares"
}

vm_rebuild() {
	validate_workspace "$1" "$2"
	local name
	name="$1-$2"
	vm_down "$1" "$2" >/dev/null
	vm_start "$1" "$2" >/dev/null
	wait_for_shares "$1" "$2"
	for _ in {1..30}; do
		if tart_command exec "$name" /run/current-system/sw/bin/bash -lc \
			'nixos-rebuild switch --flake /mnt/shared/repo#demo-dev'; then
			printf 'rebuilt %s\n' "$name"
			return 0
		fi
		sleep 1
	done
	fail "guest did not become ready for rebuild"
}

materialize() {
	preflight "$1" "$2" >/dev/null
	local root name
	root="$(workspace_dir "$1" "$2")"
	name="$1-$2"
	# shellcheck disable=SC2016 # Expansion belongs in the guest shell.
	tar -C "$root" -cf - . | tart_command exec -i "$name" /run/current-system/sw/bin/bash -lc \
		'umask 077; tar -C /run/vpn-workspace -xf -; if [[ -f /run/vpn-workspace/bookmarks/bookmarks.json ]]; then { printf "%s\n" "<!doctype html><meta charset=utf-8><title>Workspace links</title><ul>"; jq -r '\''.[] | "<li><a href=\"" + (.url | @html) + "\">" + (.title | @html) + "</a></li>"'\'' /run/vpn-workspace/bookmarks/bookmarks.json; printf "%s\n" "</ul>"; } > /run/vpn-workspace/start.html; jq --slurpfile bookmarks /run/vpn-workspace/bookmarks/bookmarks.json '\''.policies.Bookmarks = ($bookmarks[0] | map({Title: .title, URL: .url, Placement: "toolbar"}))'\'' /etc/vm-vpn/firefox-policies-base.json > /run/vpn-workspace/firefox-policies.json; else cp /etc/vm-vpn/firefox-policies-base.json /run/vpn-workspace/firefox-policies.json; fi; chmod 0600 /run/vpn-workspace/firefox-policies.json; for profile in /home/vpn/.mozilla/firefox/*.default*; do [[ -d "$profile" ]] || continue; for cert in /run/vpn-workspace/certs/*.crt; do [[ -f "$cert" ]] || continue; certutil -A -d "sql:$profile" -n "vm-vpn-runtime-$(basename "$cert")" -t "C,," -i "$cert"; done; for cert in /run/vpn-workspace/certs/*.p12; do [[ -f "$cert" ]] || continue; password="${cert%.p12}.password"; [[ -f "$password" ]] || continue; pk12util -d "sql:$profile" -i "$cert" -w "$password"; done; done; chown -R vpn:users /run/vpn-workspace; chmod -R go-rwx /run/vpn-workspace'
	printf 'runtime material ready for %s\n' "$name"
}

diagnose() {
	validate_workspace "$1" "$2"
	local root profile present="no" mode="missing" guest="no" tart_version="unavailable"
	root="$(workspace_dir "$1" "$2")"
	profile="$root/vpn/profile.ovpn"
	if [[ -f "$profile" ]]; then
		present="yes"
		mode="$(stat -c '%a' "$profile")"
	fi
	if tart_version="$(tart_command --version 2>/dev/null)"; then :; else tart_version="unavailable"; fi
	if tart_command exec "$1-$2" /run/current-system/sw/bin/true >/dev/null 2>&1; then guest="yes"; fi
	printf 'WORKSPACE=%s/%s\nNIX_VERSION=%s\nTART_VERSION=%s\nGUEST_REACHABLE=%s\nPROFILE_PRESENT=%s\nPROFILE_MODE=%s\n' \
		"$1" "$2" "$(nix --version)" "${tart_version:-unknown}" "$guest" "$present" "$mode"
	vm_status "$1" "$2"
}

cleanup() {
	validate_workspace "$1" "$2"
	local root trash item moved=0
	root="$(state_dir "$1" "$2")"
	trash="$root/.trash/$(date -u +%Y%m%dT%H%M%SZ)"
	for item in sources tart.log installer.log; do
		if [[ -e "$root/$item" ]]; then
			mkdir -p "$trash"
			mv "$root/$item" "$trash/"
			moved=1
		fi
	done
	printf 'moved_recoverable_state=%s\n' "$moved"
}

check_repository() {
	"${VM_VPN_REPO_ROOT:-$PWD}/scripts/ci-check"
}

wait_for_materialization() {
	for _ in {1..30}; do
		if materialize "$1" "$2"; then
			return 0
		fi
		sleep 1
	done
	fail "guest did not become ready for runtime material"
}

fail() {
	printf 'vm: %s\n' "$*" >&2
	exit 1
}

validate_name() {
	local kind="$1"
	local value="$2"

	if [[ ! "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
		fail "${kind} must be lowercase hostname-safe text"
	fi
}

identity() {
	if [[ "$#" -ne 2 ]]; then
		fail "identity requires PRODUCT and ENVIRONMENT"
	fi

	local product="$1"
	local environment="$2"
	validate_name "PRODUCT" "$product"
	validate_name "ENVIRONMENT" "$environment"

	validate_workspace "$product" "$environment"

	printf 'PRODUCT=%s\n' "$product"
	printf 'ENVIRONMENT=%s\n' "$environment"
	printf 'VM_NAME=%s-%s\n' "$product" "$environment"
	printf 'VM_PATH=%s/%s\n' "$product" "$environment"
}

doctor() {
	local missing=0
	local command

	for command in nix tart curl jq bats shellcheck shfmt; do
		if command -v "$command" >/dev/null 2>&1; then
			printf '%-12s %s\n' "$command" "available"
		else
			printf '%-12s %s\n' "$command" "missing" >&2
			missing=1
		fi
	done

	if [[ "$missing" -ne 0 ]]; then
		fail "enter the repository development shell before running commands"
	fi
}

main() {
	if [[ "$#" -eq 0 ]]; then
		usage
		exit 1
	fi

	case "$1" in
	-h | --help)
		usage
		;;
	identity)
		shift
		identity "$@"
		;;
	init)
		shift
		[[ "$#" -eq 2 ]] || fail "init requires PRODUCT and ENVIRONMENT"
		init_workspace "$@"
		;;
	seed)
		shift
		[[ "$#" -eq 2 ]] || fail "seed requires PRODUCT and ENVIRONMENT"
		seed_workspace "$@"
		;;
	import-vpn | import-bookmarks | import-cert)
		local command="$1"
		shift
		[[ "$#" -eq 3 ]] || fail "$command requires PRODUCT ENVIRONMENT SOURCE"
		import_file "${command#import-}" "$@"
		;;
	preflight)
		shift
		[[ "$#" -eq 2 ]] || fail "preflight requires PRODUCT and ENVIRONMENT"
		preflight "$@"
		;;
	materialize)
		shift
		[[ "$#" -eq 2 ]] || fail "materialize requires PRODUCT and ENVIRONMENT"
		materialize "$@"
		;;
	list)
		shift
		[[ "$#" -eq 0 ]] || fail "list does not accept arguments"
		list_workspaces
		;;
	status)
		shift
		[[ "$#" -eq 2 ]] || fail "status requires PRODUCT and ENVIRONMENT"
		vm_status "$@"
		;;
	down)
		shift
		[[ "$#" -eq 2 ]] || fail "down requires PRODUCT and ENVIRONMENT"
		vm_down "$@"
		;;
	up)
		shift
		[[ "$#" -eq 2 ]] || fail "up requires PRODUCT and ENVIRONMENT"
		preflight "$@"
		if ! vm_exists "$1-$2"; then
			vm_create "$@"
		fi
		vm_start "$@"
		wait_for_shares "$@"
		wait_for_materialization "$@"
		;;
	restart)
		shift
		[[ "$#" -eq 2 ]] || fail "restart requires PRODUCT and ENVIRONMENT"
		vm_down "$@"
		vm_start "$@"
		wait_for_shares "$@"
		;;
	rebuild)
		shift
		[[ "$#" -eq 2 ]] || fail "rebuild requires PRODUCT and ENVIRONMENT"
		vm_rebuild "$@"
		;;
	diagnose)
		shift
		[[ "$#" -eq 2 ]] || fail "diagnose requires PRODUCT and ENVIRONMENT"
		diagnose "$@"
		;;
	cleanup)
		shift
		[[ "$#" -eq 2 ]] || fail "cleanup requires PRODUCT and ENVIRONMENT"
		cleanup "$@"
		;;
	share-add)
		shift
		[[ "$#" -eq 4 || "$#" -eq 5 ]] || fail "share-add requires PRODUCT ENVIRONMENT NAME HOST_PATH [--read-write]"
		share_add "$@"
		;;
	share-list)
		shift
		[[ "$#" -eq 2 ]] || fail "share-list requires PRODUCT and ENVIRONMENT"
		share_list "$@"
		;;
	share-remove)
		shift
		[[ "$#" -eq 3 ]] || fail "share-remove requires PRODUCT ENVIRONMENT NAME"
		share_remove "$@"
		;;
	check)
		shift
		[[ "$#" -eq 0 ]] || fail "check does not accept arguments"
		check_repository
		;;
	doctor)
		shift
		if [[ "$#" -ne 0 ]]; then
			fail "doctor does not accept arguments"
		fi
		doctor
		;;
	*)
		fail "unknown command: $1"
		;;
	esac
}

main "$@"
