#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  install-vault-dev --device DEVICE --repo PATH --yes
  install-vault-dev --device DEVICE --repo PATH --dry-run
  install-vault-dev --device DEVICE --repo PATH --resume --yes

Partitions the Phase 1 Tart disk and installs the vault-dev NixOS closure.
The only accepted installation device is /dev/vda.
EOF
}

fail() {
	printf 'install-vault-dev: %s\n' "$*" >&2
	exit 1
}

print_command() {
	printf '%q' "$1"
	shift
	if [[ "$#" -gt 0 ]]; then
		printf ' %q' "$@"
	fi
	printf '\n'
}

run_command() {
	if [[ "$DRY_RUN" == "true" ]]; then
		print_command "$@"
	else
		"$@"
	fi
}

main() {
	local device=""
	local repo=""
	local confirmed="false"
	DRY_RUN="false"
	RESUME="false"

	while [[ "$#" -gt 0 ]]; do
		case "$1" in
		-h | --help)
			usage
			return 0
			;;
		--device)
			[[ "$#" -ge 2 ]] || fail "--device requires a value"
			device="$2"
			shift 2
			;;
		--repo)
			[[ "$#" -ge 2 ]] || fail "--repo requires a value"
			repo="$2"
			shift 2
			;;
		--yes)
			confirmed="true"
			shift
			;;
		--dry-run)
			DRY_RUN="true"
			shift
			;;
		--resume)
			RESUME="true"
			shift
			;;
		*)
			fail "unknown argument: $1"
			;;
		esac
	done

	[[ -n "$device" ]] || fail "--device is required"
	[[ -n "$repo" ]] || fail "--repo is required"
	[[ "$device" == "/dev/vda" ]] || fail "device must be the Phase 1 virtio block device /dev/vda"

	if [[ "$DRY_RUN" != "true" && "$confirmed" != "true" ]]; then
		fail "--yes is required for installation"
	fi

	if [[ "$DRY_RUN" != "true" ]]; then
		[[ "$EUID" -eq 0 ]] || fail "installation must run as root"
		[[ -b "$device" ]] || fail "device is not a block device: $device"
		[[ -f "$repo/flake.nix" ]] || fail "repository flake is missing: $repo/flake.nix"

		local command
		for command in mount nix nixos-install; do
			command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
		done

		if [[ "$RESUME" == "true" ]]; then
			mountpoint -q /mnt || fail "resume requires /mnt to be mounted"
			mountpoint -q /mnt/boot || fail "resume requires /mnt/boot to be mounted"
		else
			for command in parted mkfs.fat mkfs.ext4 udevadm; do
				command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
			done
			if lsblk -nrpo MOUNTPOINTS "$device" | grep -q '[^[:space:]]'; then
				fail "device or one of its partitions is already mounted: $device"
			fi
		fi
	fi

	if [[ "$RESUME" != "true" ]]; then
		run_command parted --script "$device" mklabel gpt
		run_command parted --script "$device" mkpart ESP fat32 1MiB 1025MiB
		run_command parted --script "$device" set 1 esp on
		run_command parted --script "$device" mkpart primary ext4 1025MiB 100%
		run_command udevadm settle
		run_command mkfs.fat -F 32 -n ESP "${device}1"
		run_command mkfs.ext4 -F -L nixos "${device}2"
		run_command mount "${device}2" /mnt
		run_command mkdir -p /mnt/boot
		run_command mount "${device}1" /mnt/boot
	fi

	if [[ "$DRY_RUN" == "true" ]]; then
		printf "nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths %q\n" "$repo#nixosConfigurations.vault-dev.config.system.build.toplevel"
		printf 'nixos-install --root /mnt --system SYSTEM_PATH --no-root-password\n'
		return 0
	fi

	local system_path
	system_path="$(nix --extra-experimental-features "nix-command flakes" build --no-link --print-out-paths "$repo#nixosConfigurations.vault-dev.config.system.build.toplevel")"
	nixos-install --root /mnt --system "$system_path" --no-root-password
}

main "$@"
