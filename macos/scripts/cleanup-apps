#!/usr/bin/env bash

set -euo pipefail

export PATH="/opt/homebrew/bin:${PATH}"

if ! command -v brew >/dev/null 2>&1; then
	printf 'cleanup-apps: Homebrew is required\n' >&2
	exit 1
fi
if ! command -v dockutil >/dev/null 2>&1; then
	printf 'cleanup-apps: dockutil is required\n' >&2
	exit 1
fi
if ! command -v killall >/dev/null 2>&1; then
	printf 'cleanup-apps: killall is required\n' >&2
	exit 1
fi

# These protected Apple applications stay on the signed system volume. Keeping
# them out of the Dock provides a focused workspace without weakening SIP.
readonly -a protected_apps=(
	Calendar
	Contacts
	FaceTime
	Freeform
	Home
	Mail
	Maps
	Messages
	Music
	News
	Notes
	Photos
	Podcasts
	Reminders
	Safari
	Stocks
	TV
	Weather
)
readonly -a dock_apps=(
	"/Applications/Firefox.app"
	"/Applications/Ghostty.app"
	"/Applications/AWS VPN Client/AWS VPN Client.app"
)

# The base image may already contain Homebrew casks. Retain only applications
# used by the VPN workspace; command-line formulae such as Neovim are separate.
while IFS= read -r cask; do
	case "$cask" in
	firefox | ghostty | aws-vpn-client)
		continue
		;;
	esac
	brew uninstall --cask --force "$cask"
done < <(brew list --cask)

while IFS= read -r formula; do
	case "$formula" in
	dockutil | jq | tart-guest-agent | */tart-guest-agent)
		continue
		;;
	esac
	brew uninstall --formula --force "$formula"
done < <(brew leaves)
brew autoremove

while IFS= read -r tap; do
	case "$tap" in
	homebrew/core | homebrew/cask | openai/tools)
		continue
		;;
	esac
	brew untap --force "$tap"
done < <(brew tap)
brew cleanup --prune=all

# Stop launchd from resurrecting Dock while we rewrite its plist; otherwise a
# respawn between --remove and --add races dockutil and reseeds the 19-item
# default. cfprefsd stays alive so it can receive dockutil's writes.
launchctl bootout "gui/$(id -u)/com.apple.Dock.agent" 2>/dev/null || true
killall -KILL Dock 2>/dev/null || true

dockutil --remove all --no-restart
for app in "${dock_apps[@]}"; do
	if [[ -d "$app" ]]; then
		dockutil --add "$app" --no-restart
	fi
done

# SIGTERM (not SIGKILL) cfprefsd so it flushes dockutil's pending CFPreferences
# writes to disk before exiting; SIGKILL would drop them and the next boot
# would see the stock Dock.
killall -TERM cfprefsd 2>/dev/null || true
sleep 2
sync

printf 'cleanup-apps: kept protected applications installed but hidden from the Dock:'
printf ' %s' "${protected_apps[@]}"
printf '\n'
