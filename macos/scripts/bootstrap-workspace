#!/usr/bin/env bash

set -euo pipefail

readonly WORKSPACE_ROOT="${VM_VPN_WORKSPACE_ROOT:-/Volumes/My Shared Files/workspace}"
readonly AWS_VPN_CLIENT="${VM_VPN_AWS_VPN_CLIENT:-/usr/local/bin/aws-vpn-client}"
readonly BOOKMARKS_SOURCE="${WORKSPACE_ROOT}/bookmarks/bookmarks.json"
readonly FIREFOX_POLICY_FILE="${VM_VPN_FIREFOX_POLICY_FILE:-/Library/Application Support/Mozilla/policies.json}"
readonly STATE_ROOT="${VM_VPN_STATE_ROOT:-${HOME}/.local/state/vm-vpn}"
readonly VPN_MANIFEST="${STATE_ROOT}/vpn-profiles"

[[ -d "$WORKSPACE_ROOT" ]] || exit 0

[[ -x "$AWS_VPN_CLIENT" ]] || {
	printf 'bootstrap-workspace: AWS VPN Client 6.0 or newer is required\n' >&2
	exit 1
}

install -d -m 0700 "$STATE_ROOT"
vpn_sources=()
desired_vpn_manifest=""
for vpn_source in "${WORKSPACE_ROOT}"/vpn/*.ovpn; do
	[[ -f "$vpn_source" ]] || continue
	profile_name="${vpn_source##*/}"
	profile_name="${profile_name%.ovpn}"
	[[ "$profile_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
		printf 'bootstrap-workspace: invalid VPN profile filename: %s\n' "${vpn_source##*/}" >&2
		exit 1
	}
	vpn_checksum="$(shasum -a 256 "$vpn_source" | awk '{ print $1 }')"
	vpn_sources+=("$vpn_source")
	if [[ -n "$desired_vpn_manifest" ]]; then
		desired_vpn_manifest+=$'\n'
	fi
	desired_vpn_manifest+="${vpn_checksum}"$'\t'"${profile_name}"
done

current_vpn_manifest=""
if [[ -f "$VPN_MANIFEST" ]]; then
	current_vpn_manifest="$(<"$VPN_MANIFEST")"
fi
if [[ "$current_vpn_manifest" != "$desired_vpn_manifest" ]]; then
	while IFS=$'\t' read -r _vpn_checksum profile_name; do
		[[ -n "$profile_name" ]] || continue
		"$AWS_VPN_CLIENT" delete-profile --profile-name "$profile_name" >/dev/null 2>&1 || true
	done <<<"$current_vpn_manifest"
	for vpn_source in "${vpn_sources[@]}"; do
		profile_name="${vpn_source##*/}"
		profile_name="${profile_name%.ovpn}"
		"$AWS_VPN_CLIENT" import-profile --profile-name "$profile_name" --config-path "$vpn_source" >/dev/null
	done
	printf '%s\n' "$desired_vpn_manifest" >"$VPN_MANIFEST"
	chmod 0600 "$VPN_MANIFEST"
fi

[[ -f "$BOOKMARKS_SOURCE" ]] || exit 0
if ! command -v jq >/dev/null 2>&1; then
	printf 'bootstrap-workspace: jq is required\n' >&2
	exit 1
fi
jq -e 'type == "array" and all(.[]; (.title | type == "string") and (.url | type == "string"))' \
	"$BOOKMARKS_SOURCE" >/dev/null

bookmark_checksum="$(shasum -a 256 "$BOOKMARKS_SOURCE" | awk '{ print $1 }')"
readonly bookmark_checksum
if [[ -f "${STATE_ROOT}/bookmarks.checksum" ]] &&
	[[ "$(<"${STATE_ROOT}/bookmarks.checksum")" == "$bookmark_checksum" ]]; then
	exit 0
fi

[[ -w "$FIREFOX_POLICY_FILE" ]] || {
	printf 'bootstrap-workspace: Firefox policy is not writable\n' >&2
	exit 1
}
policy_temp="$(mktemp "${STATE_ROOT}/policies.XXXXXX")"
readonly policy_temp
jq --slurpfile workspace_bookmarks "$BOOKMARKS_SOURCE" '
  .policies.ManagedBookmarks = (
    [{ "toplevel_name": "VM VPN" }] +
    ($workspace_bookmarks[0] | map({ "name": .title, "url": .url }))
  )
' "$FIREFOX_POLICY_FILE" >"$policy_temp"
chmod 0644 "$policy_temp"
mv "$policy_temp" "$FIREFOX_POLICY_FILE"

printf '%s\n' "$bookmark_checksum" >"${STATE_ROOT}/bookmarks.checksum"
chmod 0600 "${STATE_ROOT}/bookmarks.checksum"
