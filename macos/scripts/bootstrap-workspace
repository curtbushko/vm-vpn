#!/usr/bin/env bash

set -euo pipefail

export PATH="/opt/homebrew/bin:${PATH}"

readonly WORKSPACE_ROOT="${VM_VPN_WORKSPACE_ROOT:-/Volumes/My Shared Files/workspace}"
readonly SHARED_ROOT="${VM_VPN_SHARED_ROOT:-$(dirname "${WORKSPACE_ROOT}")}"
readonly MOUNTS_SOURCE="${WORKSPACE_ROOT}/mounts.json"
readonly AWS_VPN_CLIENT="${VM_VPN_AWS_VPN_CLIENT:-/usr/local/bin/aws-vpn-client}"
readonly BOOKMARKS_SOURCE="${WORKSPACE_ROOT}/bookmarks.json"
readonly APPEARANCE_SOURCE="${WORKSPACE_ROOT}/appearance.json"
readonly FIREFOX_POLICY_FILE="${VM_VPN_FIREFOX_POLICY_FILE:-/Applications/Firefox.app/Contents/Resources/distribution/policies.json}"
readonly STATE_ROOT="${VM_VPN_STATE_ROOT:-${HOME}/.local/state/vm-vpn}"
readonly VPN_MANIFEST="${STATE_ROOT}/vpn-profiles"
readonly WALLPAPER_FILE="${VM_VPN_WALLPAPER_FILE:-${STATE_ROOT}/wallpaper.png}"
readonly WALLPAPER_SOURCE_FILE="${STATE_ROOT}/wallpaper.ppm"
readonly SIPS="${VM_VPN_SIPS:-/usr/bin/sips}"
readonly OSASCRIPT="${VM_VPN_OSASCRIPT:-/usr/bin/osascript}"
readonly PKILL="${VM_VPN_PKILL:-/usr/bin/pkill}"
readonly SCUTIL="${VM_VPN_SCUTIL:-/usr/sbin/scutil}"
readonly SUDO="${VM_VPN_SUDO:-/usr/bin/sudo}"
readonly VM_NAME_FILE="${WORKSPACE_ROOT}/.vm-name"

[[ -d "$WORKSPACE_ROOT" ]] || exit 0

[[ -x "$AWS_VPN_CLIENT" ]] || {
	printf 'bootstrap-workspace: AWS VPN Client 6.0 or newer is required\n' >&2
	exit 1
}

install -d -m 0700 "$STATE_ROOT"

readonly FIRST_BOOT_MARKER="${STATE_ROOT}/first-boot"
if [[ ! -f "$FIRST_BOOT_MARKER" ]]; then
	printf 'bootstrap-workspace: first boot: accept the macOS permissions prompts for automation and networking so VPN and desktop configuration can complete\n'
	: >"$FIRST_BOOT_MARKER"
	chmod 0600 "$FIRST_BOOT_MARKER"
fi

vpn_sources=()
desired_vpn_manifest=""
for vpn_source in "${WORKSPACE_ROOT}"/vpn/*.ovpn; do
	[[ -f "$vpn_source" ]] || continue
	profile_name="${vpn_source##*/}"
	profile_name="${profile_name%.ovpn}"
	[[ "$profile_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
		printf 'bootstrap-workspace: invalid VPN profile filename: %s\n' "${vpn_source##*/}" >&2
		exit 1
	}
	vpn_checksum="$(shasum -a 256 "$vpn_source" | awk '{ print $1 }')"
	vpn_sources+=("$vpn_source")
	if [[ -n "$desired_vpn_manifest" ]]; then
		desired_vpn_manifest+=$'\n'
	fi
	desired_vpn_manifest+="${vpn_checksum}"$'\t'"${profile_name}"
done

current_vpn_manifest=""
if [[ -f "$VPN_MANIFEST" ]]; then
	current_vpn_manifest="$(<"$VPN_MANIFEST")"
fi
if [[ "$current_vpn_manifest" != "$desired_vpn_manifest" ]]; then
	while IFS=$'\t' read -r _vpn_checksum profile_name; do
		[[ -n "$profile_name" ]] || continue
		"$AWS_VPN_CLIENT" delete-profile --profile-name "$profile_name" >/dev/null 2>&1 || true
	done <<<"$current_vpn_manifest"
	for vpn_source in "${vpn_sources[@]}"; do
		profile_name="${vpn_source##*/}"
		profile_name="${profile_name%.ovpn}"
		"$AWS_VPN_CLIENT" import-profile --profile-name "$profile_name" --config-path "$vpn_source" >/dev/null
	done
	printf '%s\n' "$desired_vpn_manifest" >"$VPN_MANIFEST"
	chmod 0600 "$VPN_MANIFEST"
	"$PKILL" -x "AWS VPN Client" >/dev/null 2>&1 || true
fi

if [[ -f "$BOOKMARKS_SOURCE" ]]; then
	if ! command -v jq >/dev/null 2>&1; then
		printf 'bootstrap-workspace: jq is required\n' >&2
		exit 1
	fi
	jq -e 'type == "array" and all(.[]; (.title | type == "string") and (.url | type == "string"))' \
		"$BOOKMARKS_SOURCE" >/dev/null
	bookmark_checksum="$(shasum -a 256 "$BOOKMARKS_SOURCE" | awk '{ print $1 }')"
	if [[ ! -f "${STATE_ROOT}/bookmarks.checksum" ]] ||
		[[ "$(<"${STATE_ROOT}/bookmarks.checksum")" != "$bookmark_checksum" ]]; then
		[[ -w "$FIREFOX_POLICY_FILE" ]] || {
			printf 'bootstrap-workspace: Firefox policy is not writable\n' >&2
			exit 1
		}
		policy_temp="$(mktemp "${STATE_ROOT}/policies.XXXXXX")"
		jq --slurpfile workspace_bookmarks "$BOOKMARKS_SOURCE" '
  .policies.ManagedBookmarks = (
    [{ "toplevel_name": "VM VPN" }] +
    ($workspace_bookmarks[0] | map({ "name": .title, "url": .url }))
  )
' "$FIREFOX_POLICY_FILE" >"$policy_temp"
		chmod 0644 "$policy_temp"
		mv "$policy_temp" "$FIREFOX_POLICY_FILE"
		printf '%s\n' "$bookmark_checksum" >"${STATE_ROOT}/bookmarks.checksum"
		chmod 0600 "${STATE_ROOT}/bookmarks.checksum"
		"$PKILL" -x firefox >/dev/null 2>&1 || true
	fi
fi

if [[ -f "$VM_NAME_FILE" ]]; then
	desired_hostname="$(<"$VM_NAME_FILE")"
	desired_hostname="${desired_hostname%$'\n'}"
	[[ "$desired_hostname" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || {
		printf 'bootstrap-workspace: invalid vm name: %s\n' "$desired_hostname" >&2
		exit 1
	}
	hostname_checksum="$(shasum -a 256 <<<"$desired_hostname" | awk '{ print $1 }')"
	if [[ ! -f "${STATE_ROOT}/hostname.checksum" ]] ||
		[[ "$(<"${STATE_ROOT}/hostname.checksum")" != "$hostname_checksum" ]]; then
		"$SUDO" -n "$SCUTIL" --set HostName "$desired_hostname"
		"$SUDO" -n "$SCUTIL" --set LocalHostName "$desired_hostname"
		"$SUDO" -n "$SCUTIL" --set ComputerName "$desired_hostname"
		printf '%s\n' "$hostname_checksum" >"${STATE_ROOT}/hostname.checksum"
		chmod 0600 "${STATE_ROOT}/hostname.checksum"
	fi
fi

if [[ -f "$MOUNTS_SOURCE" ]]; then
	if ! command -v jq >/dev/null 2>&1; then
		printf 'bootstrap-workspace: jq is required\n' >&2
		exit 1
	fi
	mount_entries="$(sed -E 's|^[[:space:]]*//.*$||' "$MOUNTS_SOURCE" | jq -c '.[] | select(has("link"))')"
	while IFS= read -r mount_entry; do
		[[ -n "$mount_entry" ]] || continue
		mount_tag="$(printf '%s' "$mount_entry" | jq -r '.tag')"
		link_raw="$(printf '%s' "$mount_entry" | jq -r '.link')"
		tilde='~'
		if [[ "$link_raw" == "$tilde" ]]; then
			link_path="$HOME"
		elif [[ "${link_raw:0:2}" == "${tilde}/" ]]; then
			link_path="${HOME}/${link_raw:2}"
		else
			link_path="$link_raw"
		fi
		target="${SHARED_ROOT}/${mount_tag}"
		if [[ -L "$link_path" ]]; then
			if [[ "$(readlink "$link_path")" == "$target" ]]; then
				continue
			fi
			rm "$link_path"
		elif [[ -e "$link_path" ]]; then
			printf 'bootstrap-workspace: refusing to replace existing path at %s\n' "$link_path" >&2
			exit 1
		fi
		install -d -m 0755 "$(dirname "$link_path")"
		ln -s "$target" "$link_path"
	done <<<"$mount_entries"
fi

if [[ -f "$APPEARANCE_SOURCE" ]]; then
	if ! command -v jq >/dev/null 2>&1; then
		printf 'bootstrap-workspace: jq is required\n' >&2
		exit 1
	fi
	[[ -x "$SIPS" ]] || {
		printf 'bootstrap-workspace: sips is required\n' >&2
		exit 1
	}
	[[ -x "$OSASCRIPT" ]] || {
		printf 'bootstrap-workspace: osascript is required\n' >&2
		exit 1
	}
	wallpaper_color="$(jq -er '.wallpaperColor | select(test("^#[0-9A-Fa-f]{6}$"))' "$APPEARANCE_SOURCE")" || {
		printf 'bootstrap-workspace: appearance wallpaperColor must be a six-digit hex color\n' >&2
		exit 1
	}
	appearance_checksum="$(shasum -a 256 "$APPEARANCE_SOURCE" | awk '{ print $1 }')"
	if [[ ! -f "${STATE_ROOT}/appearance.checksum" ]] ||
		[[ "$(<"${STATE_ROOT}/appearance.checksum")" != "$appearance_checksum" ]]; then
		red="$((16#${wallpaper_color:1:2}))"
		green="$((16#${wallpaper_color:3:2}))"
		blue="$((16#${wallpaper_color:5:2}))"
		printf 'P3\n1 1\n255\n%s %s %s\n' "$red" "$green" "$blue" >"$WALLPAPER_SOURCE_FILE"
		"$SIPS" -s format png "$WALLPAPER_SOURCE_FILE" --out "$WALLPAPER_FILE" >/dev/null
		"$OSASCRIPT" - "$WALLPAPER_FILE" <<'EOF'
on run arguments
  tell application "System Events"
    repeat with desktop_item in desktops
      set picture of desktop_item to POSIX file (item 1 of arguments)
    end repeat
  end tell
end run
EOF
		printf '%s\n' "$appearance_checksum" >"${STATE_ROOT}/appearance.checksum"
		chmod 0600 "${STATE_ROOT}/appearance.checksum" "$WALLPAPER_FILE" "$WALLPAPER_SOURCE_FILE"
	fi
fi
