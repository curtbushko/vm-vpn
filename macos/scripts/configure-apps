#!/usr/bin/env bash

set -euo pipefail

# The host passes its zoneinfo name (e.g. America/Toronto) as $1 so the
# guest clock matches the host. Fall back to UTC when nothing is provided.
# /var/db/timezone/localtime is SIP-protected so ln cannot rewrite it; use
# systemsetup's private XPC path and also export TZ for user shells so any
# app started from Terminal or Ghostty always sees the correct zone even
# when systemsetup silently no-ops under TCC.
readonly GUEST_TIMEZONE="${1:-UTC}"
readonly zoneinfo_path="/var/db/timezone/zoneinfo/${GUEST_TIMEZONE}"
if [[ -f "$zoneinfo_path" ]]; then
	sudo /usr/bin/defaults write /Library/Preferences/com.apple.timezone.auto Active -bool false
	if ! sudo /usr/sbin/systemsetup -settimezone "$GUEST_TIMEZONE" >/dev/null; then
		printf 'configure-apps: systemsetup could not persist the timezone; user shells will still use TZ=%s\n' "$GUEST_TIMEZONE" >&2
	fi
	install -d -m 0755 "${HOME}"
	printf 'export TZ=%q\n' "$GUEST_TIMEZONE" >"${HOME}/.zshenv.vm-vpn-tz"
	chmod 0644 "${HOME}/.zshenv.vm-vpn-tz"
	if ! grep -Fq '.zshenv.vm-vpn-tz' "${HOME}/.zshenv" 2>/dev/null; then
		printf '[ -f "$HOME/.zshenv.vm-vpn-tz" ] && . "$HOME/.zshenv.vm-vpn-tz"\n' >>"${HOME}/.zshenv"
	fi
	printf 'configure-apps: guest timezone set to %s\n' "$GUEST_TIMEZONE"
else
	printf 'configure-apps: unknown timezone %s; leaving guest unchanged\n' "$GUEST_TIMEZONE" >&2
fi

readonly FIREFOX_POLICY_DIR="/Applications/Firefox.app/Contents/Resources/distribution"
readonly FIREFOX_POLICY_FILE="${FIREFOX_POLICY_DIR}/policies.json"
readonly LAUNCH_AGENT="${HOME}/Library/LaunchAgents/com.vm-vpn.bootstrap.plist"
readonly TART_AGENT="${HOME}/Library/LaunchAgents/org.openai.tart-guest-agent.plist"
readonly BOOTSTRAP_LOG="${HOME}/Library/Logs/vm-vpn-bootstrap.log"
readonly BOOTSTRAP_ERROR_LOG="${HOME}/Library/Logs/vm-vpn-bootstrap.error.log"

if [[ ! -x "${HOME}/.local/bin/vm-vpn-bootstrap" ]]; then
	printf 'configure-apps: vm-vpn-bootstrap is required\n' >&2
	exit 1
fi

# Use traditional (non-natural) scroll direction so a physical wheel mouse
# scrolls the way most users expect on a workstation.
defaults write -g com.apple.swipescrolldirection -bool false

install -d -m 0700 "${HOME}/.config/ghostty"
cat >"${HOME}/.config/ghostty/config" <<'EOF'
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-size = 14
window-padding-x = 12
window-padding-y = 10
macos-option-as-alt = true
auto-update = off
desktop-notifications = false
EOF

sudo install -d -m 0755 "$FIREFOX_POLICY_DIR"
sudo chown "$(id -u):$(id -g)" "$FIREFOX_POLICY_DIR"
sudo tee "${FIREFOX_POLICY_FILE}" >/dev/null <<'EOF'
{
  "policies": {
    "DisplayBookmarksToolbar": "always",
    "Homepage": {
      "URL": "about:blank",
      "Locked": true,
      "StartPage": "none"
    },
    "NewTabPage": false,
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "DisableProfileImport": true,
    "DontCheckDefaultBrowser": true,
    "SkipTermsOfUse": true,
    "DisableFirefoxAccounts": true,
    "PasswordManagerEnabled": false,
    "OfferToSaveLogins": false,
    "UserMessaging": {
      "SkipOnboarding": true,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "MoreFromMozilla": false,
      "Locked": true
    },
    "ManagedBookmarks": [
      { "toplevel_name": "VM VPN" }
    ],
    "ExtensionSettings": {
      "{446900e4-71c2-419f-a6a7-df9c091e268b}": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi",
        "default_area": "navbar"
      },
      "{d634138d-c276-4fc8-924b-40a0ea21d284}": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/1password-x-password-manager/latest.xpi",
        "default_area": "navbar"
      }
    },
    "Preferences": {
      "browser.theme.content-theme": 0,
      "browser.theme.toolbar-theme": 0,
      "browser.toolbars.bookmarks.visibility": "always",
      "intl.accept_languages": "en-US, en",
      "intl.locale.requested": "en-US",
      "sidebar.revamp": { "Value": false, "Status": "locked" },
      "sidebar.verticalTabs": { "Value": false, "Status": "locked" },
      "ui.systemUsesDarkTheme": 1
    }
  }
}
EOF
sudo chown "$(id -u):$(id -g)" "${FIREFOX_POLICY_FILE}"
sudo chmod 0644 "${FIREFOX_POLICY_FILE}"

# Ensure a Firefox profile exists before runtime configuration is mounted so
# managed policies are available on the first interactive launch.
/Applications/Firefox.app/Contents/MacOS/firefox -CreateProfile vm-vpn >/dev/null

# Mozilla's enterprise-policy pref block-list silently drops security.webauth*
# and security.webauthn* prefs, so apply them via Firefox's autoconfig
# mechanism (Contents/Resources/defaults/pref/autoconfig.js chains to
# Contents/Resources/vm-vpn.cfg) so Bitwarden's software token handles
# WebAuthn for every profile, regardless of which one Firefox launches.
readonly FIREFOX_RESOURCES="/Applications/Firefox.app/Contents/Resources"
sudo install -d -m 0755 "${FIREFOX_RESOURCES}/defaults/pref"
sudo tee "${FIREFOX_RESOURCES}/defaults/pref/autoconfig.js" >/dev/null <<'EOF'
pref("general.config.filename", "vm-vpn.cfg");
pref("general.config.obscure_value", 0);
pref("general.config.sandbox_enabled", false);
EOF
sudo tee "${FIREFOX_RESOURCES}/vm-vpn.cfg" >/dev/null <<'EOF'
// The first line is ignored by Firefox's autoconfig loader.
lockPref("security.webauth.webauthn_enable_softtoken", true);
lockPref("security.webauthn.enable_macos_passkeys", false);
EOF
sudo chmod 0644 \
	"${FIREFOX_RESOURCES}/defaults/pref/autoconfig.js" \
	"${FIREFOX_RESOURCES}/vm-vpn.cfg"
defaults write com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers -array \
	'{ LSHandlerURLScheme = http; LSHandlerRoleAll = org.mozilla.firefox; }' \
	'{ LSHandlerURLScheme = https; LSHandlerRoleAll = org.mozilla.firefox; }' \
	'{ LSHandlerContentType = public.html; LSHandlerRoleAll = org.mozilla.firefox; }' \
	'{ LSHandlerContentType = public.xhtml; LSHandlerRoleAll = org.mozilla.firefox; }'

# AWS VPN Client 6.0.x uses SMAppService: a helper app bundled at
# Contents/Frameworks/AWS VPN Client Helper.app that the main client registers
# on first launch via SMAppService.register(). Without that registration the
# tunnel opens but the client cannot push DNS via SystemConfiguration, so
# internal names never resolve. There is no privileged prompt to trigger, so
# just launch the client once here to force registration, then quit it so the
# rest of the build proceeds. The launch is best-effort; a missing app bundle
# or a headless build session is not fatal.
if [[ -d "/Applications/AWS VPN Client/AWS VPN Client.app/Contents/Frameworks/AWS VPN Client Helper.app" ]]; then
	open -a "AWS VPN Client" >/dev/null 2>&1 || true
	sleep 5
	osascript -e 'tell application "AWS VPN Client" to quit' >/dev/null 2>&1 || true
	sleep 2
	pkill -x "AWS VPN Client" >/dev/null 2>&1 || true
fi

install -d -m 0700 "${HOME}/.config/AWSVPNClient/OpenVpnConfigs" "${HOME}/Library/LaunchAgents" "${HOME}/Library/Logs"
cat >"$LAUNCH_AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vm-vpn.bootstrap</string>
  <key>ProgramArguments</key>
  <array><string>${HOME}/.local/bin/vm-vpn-bootstrap</string></array>
  <key>StandardOutPath</key><string>${BOOTSTRAP_LOG}</string>
  <key>StandardErrorPath</key><string>${BOOTSTRAP_ERROR_LOG}</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>30</integer>
</dict>
</plist>
EOF
chmod 0600 "$LAUNCH_AGENT"

cat >"$TART_AGENT" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.openai.tart-guest-agent</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/tart-guest-agent</string><string>--run-agent</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
EOF
chmod 0600 "$TART_AGENT"
# Keep the literal invocation visible for operators inspecting the generated
# launch agent: tart-guest-agent --run-agent

for notification_bundle_id in \
	com.mitchellh.ghostty \
	com.amazonaws.acvc.mac.gui \
	com.amazonaws.acvc.mac.svc \
	com.cirruslabs.tart-guest-agent \
	com.apple.backgroundtaskmanagementagent; do
	defaults write com.apple.ncprefs apps -array-add \
		"{ \"bundle-id\" = \"${notification_bundle_id}\"; flags = 8460; }"
done

defaults write NSGlobalDomain AppleInterfaceStyle -string Dark
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false
defaults write NSGlobalDomain AppleLanguages -array "en-US"
defaults write NSGlobalDomain AppleLocale -string "en_US"
launchctl setenv LANG "en_US.UTF-8"
launchctl setenv LC_ALL "en_US.UTF-8"
printf '00000000: 1ced 3f4a bcbc ba2c caca 4e82\n' | sudo /usr/bin/xxd -r - /etc/kcpassword
sudo defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser admin
sudo defaults write /Library/Preferences/com.apple.screensaver loginWindowIdleTime 0
defaults -currentHost write com.apple.screensaver idleTime 0
sudo systemsetup -setsleep Off >/dev/null
