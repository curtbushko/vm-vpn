#!/usr/bin/env bash

set -euo pipefail

sudo /usr/sbin/networksetup -setdnsservers Ethernet 1.1.1.1 8.8.8.8

if ! command -v /usr/bin/curl >/dev/null 2>&1; then
	printf 'install-apps: curl is required\n' >&2
	exit 1
fi

if [[ ! -x /opt/homebrew/bin/brew ]]; then
	NONINTERACTIVE=1 /bin/bash -c "$(/usr/bin/curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
export PATH="/opt/homebrew/bin:${PATH}"

brew update
brew install --cask firefox
brew install --cask ghostty
brew install --cask aws-vpn-client
if [[ ! -x /usr/local/bin/aws-vpn-client ]]; then
	printf 'install-apps: AWS VPN Client 6.0 or newer is required\n' >&2
	exit 1
fi

# Clear only bundle-level quarantine metadata after installation. Recursing
# into signed application contents can fail on vendor-protected files and is
# unnecessary for suppressing the first-launch Gatekeeper dialog.
readonly -a trusted_apps=(
	"/Applications/Firefox.app"
	"/Applications/Ghostty.app"
	"/Applications/AWS VPN Client/AWS VPN Client.app"
)
for app in "${trusted_apps[@]}"; do
	if xattr -p com.apple.quarantine "$app" >/dev/null 2>&1; then
		xattr -d com.apple.quarantine "$app"
	fi
done
brew install jq
brew install dockutil
brew install openai/tools/tart-guest-agent

# Bake the Firefox force-installed extensions into the image so first-launch
# resolution does not need addons.mozilla.org (the runtime guest may have no
# usable DNS until the VPN pushes its own resolvers). configure-apps writes a
# policies.json that references these local paths via file:// install_url.
readonly FIREFOX_EXT_DIR="/Applications/Firefox.app/Contents/Resources/distribution/extensions"
printf 'install-apps: baking Firefox extensions into %s\n' "$FIREFOX_EXT_DIR"
sudo /bin/mkdir -p "$FIREFOX_EXT_DIR"
sudo /usr/sbin/chown "$(id -u):$(id -g)" "$FIREFOX_EXT_DIR"
/usr/bin/curl -fsSL \
	-o "${FIREFOX_EXT_DIR}/{446900e4-71c2-419f-a6a7-df9c091e268b}.xpi" \
	https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi
/usr/bin/curl -fsSL \
	-o "${FIREFOX_EXT_DIR}/{d634138d-c276-4fc8-924b-40a0ea21d284}.xpi" \
	https://addons.mozilla.org/firefox/downloads/latest/1password-x-password-manager/latest.xpi
chmod 0644 "${FIREFOX_EXT_DIR}"/*.xpi
ls -la "$FIREFOX_EXT_DIR"
