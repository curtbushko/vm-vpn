#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
readonly REPO_ROOT
readonly VM_NAME="${1:-vm-vpn-base}"
readonly BUILD_VM_NAME="${VM_NAME}-building"

for command in packer tart; do
	if ! command -v "$command" >/dev/null 2>&1; then
		printf 'build-image: %s is required; run through nix develop\n' "$command" >&2
		exit 1
	fi
done

if tart get "$VM_NAME" >/dev/null 2>&1; then
	printf 'build-image: VM already exists: %s\n' "$VM_NAME" >&2
	exit 1
fi
if tart get "$BUILD_VM_NAME" >/dev/null 2>&1; then
	tart stop "$BUILD_VM_NAME" >/dev/null 2>&1 || true
	tart delete "$BUILD_VM_NAME"
fi

stop_build_guest() {
	if tart get "$BUILD_VM_NAME" 2>/dev/null | tail -n 1 | grep -q 'running$'; then
		tart stop "$BUILD_VM_NAME"
	fi
}

wait_for_guest() {
	local attempt=0
	while ((attempt < 60)); do
		if tart exec "$BUILD_VM_NAME" /usr/bin/true >/dev/null 2>&1; then
			return 0
		fi
		((attempt += 1))
		sleep 2
	done
	printf 'build-image: rebuilt guest did not become ready\n' >&2
	return 1
}

shutdown_build_guest() {
	local shutdown_attempt=0
	# The guest can close Tart's transport before the shutdown RPC returns.
	# Observe the VM state instead of treating that disconnect as a failure.
	tart exec "$BUILD_VM_NAME" sudo /sbin/shutdown -h now 2>/dev/null || true
	while ((shutdown_attempt < 60)); do
		if tart get "$BUILD_VM_NAME" 2>/dev/null | tail -n 1 | grep -q 'stopped$'; then
			wait "$tart_pid" || true
			return 0
		fi
		((shutdown_attempt += 1))
		sleep 2
	done
	printf 'build-image: guest did not stop after graceful shutdown\n' >&2
	return 1
}
trap stop_build_guest EXIT

# Size the guest display to ~80% of the host's main logical display so the VM
# window fits comfortably on any Mac. Users can pin an explicit resolution
# with VM_VPN_DISPLAY=WIDTHxHEIGHT.
detect_display() {
	if [[ -n "${VM_VPN_DISPLAY:-}" ]]; then
		printf '%s' "$VM_VPN_DISPLAY"
		return
	fi
	local profile dims retina=0
	profile="$(system_profiler SPDisplaysDataType 2>/dev/null)"
	dims="$(printf '%s' "$profile" | awk '
		/UI Looks like:/ {
			if (match($0, /[0-9]+ x [0-9]+/)) { print substr($0, RSTART, RLENGTH); exit }
		}
	')"
	if [[ -z "$dims" ]]; then
		local resline
		resline="$(printf '%s' "$profile" | awk '/Resolution:/ { print; exit }')"
		if [[ "$resline" == *Retina* ]]; then
			retina=1
		fi
		dims="$(printf '%s' "$resline" | awk '{ if (match($0, /[0-9]+ x [0-9]+/)) print substr($0, RSTART, RLENGTH) }')"
	fi
	if [[ -z "$dims" ]]; then
		printf '1440x900'
		return
	fi
	local host_w host_h
	host_w="${dims%% x *}"
	host_h="${dims##* x }"
	if ((retina == 1)); then
		host_w=$((host_w / 2))
		host_h=$((host_h / 2))
	fi
	printf '%dx%d' "$((host_w * 4 / 5))" "$((host_h * 4 / 5))"
}
display="$(detect_display)"
printf 'build-image: guest display resolution: %s\n' "$display"

cd "$REPO_ROOT"
packer init macos/packer/vpn-workspace.pkr.hcl
packer build -color=false \
	-var "vm_name=${BUILD_VM_NAME}" \
	-var "display=${display}" \
	macos/packer/vpn-workspace.pkr.hcl

# Let Virtualization.Framework release Packer's cloned disk before the
# provisioning boot. Keep Tart attached to this terminal because detached
# AppKit launches can fail to start guests on current macOS hosts.
sleep 5
tart run "$BUILD_VM_NAME" &
tart_pid=$!

env VM_NAME="$BUILD_VM_NAME" "${SCRIPT_DIR}/bootstrap-guest-agent"
env VM_NAME="$BUILD_VM_NAME" "${SCRIPT_DIR}/provision-vm"
shutdown_build_guest

# Verify again after a normal reboot. macOS persists some user preferences,
# including the Dock, only during a graceful guest shutdown.
tart run "$BUILD_VM_NAME" &
tart_pid=$!
wait_for_guest
tart exec -i "$BUILD_VM_NAME" /bin/bash -s <"${SCRIPT_DIR}/verify-image"
shutdown_build_guest
trap - EXIT
tart rename "$BUILD_VM_NAME" "$VM_NAME"
tart get "$VM_NAME"
printf 'built immutable macOS appliance %s\n' "$VM_NAME"
