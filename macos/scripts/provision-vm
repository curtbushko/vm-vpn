#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

if ! command -v tart >/dev/null 2>&1; then
	printf 'provision-vm: tart is required\n' >&2
	exit 1
fi
if [[ -z "${VM_NAME:-}" ]]; then
	printf 'provision-vm: VM_NAME is required\n' >&2
	exit 1
fi

for attempt in {1..120}; do
	if tart exec "$VM_NAME" /usr/bin/true >/dev/null 2>&1; then
		break
	fi
	if [[ "$attempt" -eq 120 ]]; then
		printf 'provision-vm: Tart guest agent did not become ready\n' >&2
		exit 1
	fi
	sleep 2
done

if ! tart exec -i "$VM_NAME" /bin/bash -c \
	"install -d -m 0700 \"\${HOME}/.local/bin\"; /usr/bin/tee \"\${HOME}/.local/bin/vm-vpn-bootstrap\" >/dev/null; chmod 0700 \"\${HOME}/.local/bin/vm-vpn-bootstrap\"" \
	<"${SCRIPT_DIR}/bootstrap-workspace"; then
	printf 'provision-vm: failed to install guest bootstrap\n' >&2
	exit 1
fi

for guest_script in install-apps configure-apps cleanup-apps seal-image verify-image; do
	tart exec -i "$VM_NAME" /bin/bash -s <"${SCRIPT_DIR}/${guest_script}"
done
