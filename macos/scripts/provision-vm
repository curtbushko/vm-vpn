#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

if ! command -v tart >/dev/null 2>&1; then
	printf 'provision-vm: tart is required\n' >&2
	exit 1
fi
if [[ -z "${VM_NAME:-}" ]]; then
	printf 'provision-vm: VM_NAME is required\n' >&2
	exit 1
fi

for attempt in {1..120}; do
	if tart exec "$VM_NAME" /usr/bin/true >/dev/null 2>&1; then
		break
	fi
	if [[ "$attempt" -eq 120 ]]; then
		printf 'provision-vm: Tart guest agent did not become ready\n' >&2
		exit 1
	fi
	sleep 2
done

if ! tart exec -i "$VM_NAME" /bin/bash -c \
	"install -d -m 0700 \"\${HOME}/.local/bin\"; /usr/bin/tee \"\${HOME}/.local/bin/vm-vpn-bootstrap\" >/dev/null; chmod 0700 \"\${HOME}/.local/bin/vm-vpn-bootstrap\"" \
	<"${SCRIPT_DIR}/bootstrap-workspace"; then
	printf 'provision-vm: failed to install guest bootstrap\n' >&2
	exit 1
fi

# Read the host's zoneinfo name (e.g. America/Toronto) so the guest can match
# it. readlink of /etc/localtime resolves to /var/db/timezone/zoneinfo/<name>
# on modern macOS; strip the prefix down to <name>.
host_timezone="${VM_VPN_TIMEZONE:-}"
if [[ -z "$host_timezone" ]] && [[ -L /etc/localtime ]]; then
	host_timezone="$(readlink /etc/localtime)"
	host_timezone="${host_timezone#*zoneinfo/}"
fi
host_timezone="${host_timezone:-UTC}"
readonly host_timezone

for guest_script in install-apps configure-apps seal-image cleanup-apps verify-image; do
	case "$guest_script" in
		configure-apps)
			tart exec -i "$VM_NAME" /bin/bash -s -- "$host_timezone" \
				<"${SCRIPT_DIR}/${guest_script}"
			;;
		*)
			tart exec -i "$VM_NAME" /bin/bash -s <"${SCRIPT_DIR}/${guest_script}"
			;;
	esac
done
